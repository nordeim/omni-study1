# Build context hygiene — keep the image lean and the build cache stable.
# Mirrors .gitignore's intent (plus container-specific entries).

# VCS / docs / planning (never needed inside the image)
.git
.gitignore
docs/
skills/
*.md
!README.md

# Build outputs (rebuilt inside the container)
.next/
out/

# The local databases NEVER enter the image (the container's SQLite lives
# on the /data volume — DEPLOYMENT.md §4 form-2)
db/
db/*.db

# Dependencies (installed in the stages, never copied from the host)
node_modules/

# Test + tooling (devDeps install covers what the build needs)
tests/
test-results/
playwright-report/
coverage/

# Local state / logs / OS noise
.env
.env.local
dev.log
server.log
*.log
.DS_Store
.idea/
.vscode/
