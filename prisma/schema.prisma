// ---------------------------------------------------------------------------
// StudyFlow (Omni-Study) — Prisma schema (24 models)
//
// DATABASE PATH CONTRACT (pinned by tests/db-path.test.ts — read .env.example):
//   DATABASE_URL="file:../db/custom.db" must resolve to <repo>/db/custom.db
//   for the Prisma CLI (schema-anchored) AND the runtime (src/lib/db-path.ts
//   applies the same rule). The `db:*` package scripts set the env var inline
//   (shell-provided → schema-anchored); never rely on repo-root .env
//   auto-loading with the raw CLI.
//
// Relations: every user-owned model carries `userId` with onDelete: Cascade
// (Flashcard is the documented exception — scoped through its deck, S7).
// Nullable subject/list/notebook/folder references use SetNull.
// ---------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String
  fullName             String   @default("")
  // Preferences (theme system — see src/lib/theme.ts; persisted via
  // PATCH /api/settings/preferences)
  themeMode            String   @default("system") // light | dark | system
  accentColor          String   @default("violet")
  avatarEmoji          String   @default("") // "" = initial-letter default state
  notificationsEnabled Boolean  @default(true)
  // S17 study profile (the reference's own Profile tab fields)
  schoolName           String   @default("")
  gradeLevel           String   @default("")
  studyGoalHours       Int      @default(4) // 1–12
  // S15 auth flows: registration creates an UNVERIFIED account
  emailVerified        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subjects            Subject[]
  taskLists           TaskList[]
  tasks               Task[]
  assignments         Assignment[]
  exams               Exam[]
  events              Event[]
  timetableClasses    TimetableClass[]
  notebooks           Notebook[]
  notes               Note[]
  flashcardDecks      FlashcardDeck[]
  practiceTests       PracticeTest[]
  studyGroups         StudyGroup[]
  grades              Grade[]
  focusSessions       FocusSession[]
  fileFolders         FileFolder[]
  fileItems           FileItem[]
  aiChatMessages      AiChatMessage[]
  calculatorHistory   CalculatorHistoryEntry[]
  holidays            Holiday[]
  rumEvents           RumEvent[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit OTP
  expiresAt DateTime // 15-minute window
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // 48-hex one-shot
  expiresAt DateTime // 30-minute window
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks          Task[]
  assignments    Assignment[]
  exams          Exam[]
  timetableClass TimetableClass[]
  flashcardDecks FlashcardDeck[]
  practiceTests  PracticeTest[]
  studyGroups    StudyGroup[]
  grades         Grade[]
  focusSessions  FocusSession[]
  notes          Note[]

  @@index([userId])
}

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String // 1..200
  notes     String    @default("")
  listId    String?
  subjectId String?
  completed Boolean   @default(false)
  important Boolean   @default(false)
  dueDate   DateTime?
  // S6-B reference dialog fields
  priority  String    @default("none") // none | low | medium | high
  repeat    String    @default("none") // none | daily | weekly | monthly
  myDay     Boolean   @default(false)
  subtasks  String    @default("[]") // JSON [{id,title,done}]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([listId])
}

model Assignment {
  id          String    @id @default(cuid())
  userId      String
  title       String // 1..200
  description String    @default("")
  subjectId   String?
  dueDate     DateTime?
  // S6-E reference row fields
  type        String    @default("homework") // homework | essay | project | reading | lab | presentation | other
  progress    Int       @default(0) // 0..100
  priority    String    @default("medium") // low | medium | high | urgent
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Exam {
  id        String   @id @default(cuid())
  userId    String
  title     String // 1..200
  date      DateTime
  subjectId String?
  // S6-F reference card fields
  type      String   @default("test") // test | quiz | midterm | final | oral | practical
  duration  Int      @default(60) // minutes (5..6000)
  topics    String   @default("[]") // JSON string array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Event {
  id        String    @id @default(cuid())
  userId    String
  title     String // 1..200
  startDate DateTime
  endDate   DateTime?
  allDay    Boolean   @default(false)
  color     String    @default("#8b5cf6")
  // S5-B2 reference dialog fields
  location  String    @default("")
  repeat    String    @default("none") // none | daily | weekly | monthly
  reminders String    @default("[]") // JSON [minutesBefore]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimetableClass {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dayOfWeek Int // 0=Monday … 6=Sunday (ISO minus one)
  startTime String // "9:00"
  endTime   String
  subjectId String?
  room      String   @default("")
  weekType  String   @default("ALL") // ALL | A | B (S5-J)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Notebook {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([userId])
}

model Note {
  id         String    @id @default(cuid())
  userId     String
  title      String // 1..200
  content    String    @default("")
  notebookId String?
  subjectId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook   Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([notebookId])
}

model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  color       String   @default("#8b5cf6")
  subjectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  cards       Flashcard[]

  @@index([userId])
}

// S7 nesting: Flashcard carries NO userId — ownership scopes through its deck.
model Flashcard {
  id         String        @id @default(cuid())
  deckId     String
  front      String
  back       String
  difficulty String        @default("medium") // easy | medium | hard
  mastered   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
}

model PracticeTest {
  id              String   @id @default(cuid())
  userId          String
  title           String // 1..200
  durationMinutes Int      @default(60)
  questions       String   @default("[]") // JSON [{question,type}]
  subjectId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model StudyGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subjectId String?
  // JSON string of [{name,email}] — validated as an array at the boundary,
  // serialized by the route (members capped at 50).
  members   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Grade {
  id        String   @id @default(cuid())
  userId    String
  title     String
  score     Float
  maxScore  Float    @default(100)
  weight    Float    @default(1) // credit weight
  subjectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model FocusSession {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String?
  startedAt       DateTime
  durationSeconds Int
  mode            String   @default("focus") // focus | short-break | long-break
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model FileFolder {
  id        String       @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    FileFolder?  @relation("FolderNesting", fields: [parentId], references: [id], onDelete: SetNull)
  children  FileFolder[] @relation("FolderNesting")
  items     FileItem[]

  @@index([userId])
}

model FileItem {
  id        String      @id @default(cuid())
  userId    String
  name      String
  mime      String
  size      Int
  data      String? // base64 ≤ 2 MiB; null + url for link-files
  url       String?
  folderId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    FileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  surface   String   @default("assistant") // assistant | solver
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalculatorHistoryEntry {
  id         String   @id @default(cuid())
  userId     String
  expression String
  result     String
  mode       String   @default("basic") // basic | scientific | gpa | unit
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Holiday {
  id        String   @id @default(cuid())
  userId    String
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RumEvent {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String
  metric         String // TTFB | FCP | LCP | CLS | INP
  value          Float
  rating         String // good | needs-improvement | poor
  navigationType String
  path           String   @default("/")
  userAgent      String   @default("")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // S18: the beacon UPSERTS on this pair — final value wins.
  @@unique([sessionId, metric])
  @@index([userId])
}
